# Dhanz GPT (DHANZ AI): environment variables. Copy to .env.local and fill in.
# On the DHANZ AI server, scripts/server/deploy_dhanz_gpt.py writes these itself (see docs/DHANZ_GPT.md).
# Never commit real values. Everything without NEXT_PUBLIC_ stays on the server.

# --- Auth -------------------------------------------------------------------
# "dhanz" = DHANZ AI accounts (the server). "supabase" = Google sign-in on Supabase.
# "dev" = demo sign-in by email, honoured on localhost only.
AUTH_MODE=
NEXT_PUBLIC_AUTH_MODE=supabase
# dhanz mode: the DHANZ API base, e.g. http://api:8000/api/v1 on the server.
DHANZ_API_URL=
# Only Google accounts on this domain can sign in (the database trigger enforces it too).
NEXT_PUBLIC_WORKSPACE_DOMAIN=example.com

# --- Supabase (Project Settings → API / Database) ----------------------------
NEXT_PUBLIC_SUPABASE_URL=
# The anon / publishable key. Safe in the browser: row-level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server only. Used for Storage and account deletion.
SUPABASE_SERVICE_ROLE_KEY=
# Pooled connection string (Supavisor, transaction mode, port 6543) for the app.
DATABASE_URL=
# Direct or session connection string (port 5432) for running migrations.
DATABASE_URL_MIGRATIONS=
DATABASE_POOL_MAX=5

# --- Files -------------------------------------------------------------------
# "supabase" in deployments; "local" writes to .data/blobs for development.
STORAGE_DRIVER=supabase
# Per-person storage cap in bytes (default 20 GB).
STORAGE_QUOTA_BYTES=

# --- Claude (console.anthropic.com → API keys) ------------------------------
# "anthropic" for real answers; "demo" = offline sample model.
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional: model for chat titles (default claude-haiku-5-5).
TITLE_MODEL=
# Optional: model that rebuilds each person's memory summary, at most hourly (default claude-haiku-5-5).
MEMORY_MODEL=
# Web search through Claude's web search tool, billed per search on the same key ($10 per 1,000 + tokens).
# "auto" = Claude decides when to search; "manual" = only when someone picks Search the web; "off".
WEB_SEARCH=auto
# Most searches in one answer (default 5).
WEB_SEARCH_MAX_USES=
# Most file text one message can attach, in estimated tokens (default 150000). Bigger sets go in a project.
MESSAGE_FILE_TOKEN_BUDGET=

# --- Images (platform.openai.com → API keys) ---------------------------------
# "openai" for real images; "placeholder" = labelled stand-in renders.
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
# Check OpenAI's docs for the current image model name before launch.
IMAGE_MODEL=gpt-image-1
# Dictation (speech to text) uses the same OpenAI key. "off" hides the Dictate button.
TRANSCRIBE_PROVIDER=openai
# gpt-transcribe is OpenAI's current recommended model; the older transcribe models shut down Feb 2027.
TRANSCRIBE_MODEL=gpt-transcribe

# --- Email (resend.com → API keys; verify your sending domain first) ----------
# "resend" sends through Resend; "off" sends nothing (everything still shows in the app).
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# A sender on the domain you verified in Resend.
EMAIL_FROM=Dhanz GPT <gpt@dhanzai.com>
# The app's public address, used for links in emails.
APP_URL=https://gpt.dhanzai.com

# --- Browser push notifications (scheduled task results) ----------------------
# Generate once with: npx web-push generate-vapid-keys   (no account needed; keep the private key secret)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:gpt@dhanzai.com

# --- Data export -------------------------------------------------------------
# Most file bytes packed into one export zip (default 200 MB); bigger Libraries are listed, not packed.
EXPORT_FILES_MAX_BYTES=

# --- App connections (Apps page; each person connects their own account) -------
# Encrypts app tokens at rest (AES-256-GCM): 32 random bytes, base64.  openssl rand -base64 32
APP_TOKEN_KEY=
# Google Drive: Google Cloud console → APIs & Services → Credentials → OAuth client (Web).
# Redirect URI: {APP_URL}/api/apps/google_drive/callback. Enable the Google Drive API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Slack: api.slack.com/apps → your app → OAuth & Permissions. User token scopes:
# search:read, channels:read, channels:history, chat:write. Redirect URL: {APP_URL}/api/apps/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Shopify: a custom app for your store (Partner dashboard or the store's Develop apps).
# Scopes: read_products, write_products. Redirect URL: {APP_URL}/api/apps/shopify/callback
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Admin GraphQL API version (check shopify.dev for the current stable one).
SHOPIFY_API_VERSION=2026-10

# --- Scheduled jobs ----------------------------------------------------------
# Any long random string. Vercel Cron sends it as a bearer token to /api/cron/*.
CRON_SECRET=
# Self-hosted: 1 = the app calls its own /api/cron/* routes on the Vercel schedule.
SELF_CRON=

# --- Seeding -----------------------------------------------------------------
WORKSPACE_NAME=DHANZ AI
WORKSPACE_DOMAIN=example.com
