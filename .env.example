# ---- DHANZ AI backend configuration ---------------------------------------
# Copy to .env (never commit .env). Provider keys stay on the server only;
# the mobile/desktop apps never see them.

# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated origins allowed to call the API from a browser (Flutter web/dev tools).
CORS_ORIGINS=http://localhost:3000

# Database. docker-compose builds DATABASE_URL from these; for a bare-metal run set DATABASE_URL directly,
# e.g. postgresql+asyncpg://dhanz:secret@localhost:5432/dhanz  (sqlite+aiosqlite:///./dhanz.db for quick dev)
POSTGRES_USER=dhanz
POSTGRES_PASSWORD=
POSTGRES_DB=dhanz
# DATABASE_URL=

# ---- AI providers (configure at least one) --------------------------------
OPENAI_API_KEY=
OPENAI_MODELS=gpt-4.1-mini,gpt-4.1
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint works

ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=claude-sonnet-5-5,claude-haiku-5-5,claude-opus-5-5

GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro

# Local models via Ollama (https://ollama.com). From inside docker use http://host.docker.internal:11434
OLLAMA_BASE_URL=
OLLAMA_MODELS=llama3.1

# balanced | cheapest | best | local_first
DEFAULT_ROUTING_POLICY=balanced
DEFAULT_MAX_TOKENS=2048

# ---- Limits ----------------------------------------------------------------
MAX_MESSAGE_CHARS=32000
HISTORY_MAX_MESSAGES=40
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=30
