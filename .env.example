# ---- DHANZ AI backend configuration ---------------------------------------
# Copy to .env (never commit .env). Provider keys stay on the server only;
# the mobile/desktop apps never see them.

# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated origins allowed to call the API from a browser (Flutter web/dev tools).
CORS_ORIGINS=http://localhost:3000

# Database. docker-compose builds DATABASE_URL from these; for a bare-metal run set DATABASE_URL directly,
# e.g. postgresql+asyncpg://dhanz:secret@localhost:5432/dhanz  (sqlite+aiosqlite:///./dhanz.db for quick dev)
POSTGRES_USER=dhanz
POSTGRES_PASSWORD=
POSTGRES_DB=dhanz
# DATABASE_URL=

# ---- AI providers (configure at least one) --------------------------------
OPENAI_API_KEY=
OPENAI_MODELS=gpt-4.1-mini,gpt-4.1
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint works

ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=claude-sonnet-5-5,claude-haiku-5-5,claude-opus-5-5

GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro

# Local models via Ollama (https://ollama.com). From inside docker use http://host.docker.internal:11434
OLLAMA_BASE_URL=
OLLAMA_MODELS=llama3.1

# ---- Web research & knowledge library (Phase 2) ----------------------------
# Web search provider: none | brave | tavily | searxng. With "none", Dhanz can still read links you paste
# but tells you it cannot search the web.
SEARCH_PROVIDER=none
BRAVE_API_KEY=
TAVILY_API_KEY=
# Self-hosted SearXNG with JSON output enabled, e.g. http://searxng:8080
SEARXNG_URL=
RESEARCH_MAX_RESULTS=6
RESEARCH_MAX_PAGES=4
# Identifies the fetcher to websites (robots.txt rules are matched against "DhanzAI-Research").
FETCH_USER_AGENT=DhanzAI-Research/0.2 (+https://github.com/rodsangle/videotomp3)

# Semantic search for the knowledge library: none | openai | gemini | ollama (uses that provider's key/URL above).
# Without one, the library uses keyword search.
EMBEDDING_PROVIDER=none
# EMBEDDING_MODEL=text-embedding-3-small
RATE_LIMIT_INGEST_PER_MINUTE=20

# ---- Files, voice & memory (Phase 3) -----------------------------------------
# Uploaded files are stored here (docker-compose mounts a volume at /srv/data).
STORAGE_DIR=./data/uploads
MAX_UPLOAD_MB=20
MAX_ATTACHMENTS_PER_MESSAGE=5
# Optional malware scanning with ClamAV: `docker compose --profile scan up` starts clamd.
# When set, uploads that cannot be scanned are rejected.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Voice assistant speech-to-text: none | openai (any OpenAI-compatible /audio/transcriptions,
# e.g. OpenAI or a self-hosted Whisper server via STT_BASE_URL). Text-to-speech runs on the device.
STT_PROVIDER=none
STT_MODEL=gpt-4o-mini-transcribe
# STT_BASE_URL=
# STT_API_KEY=

# ---- Push notifications & app updates (Phase 4) -----------------------------
# Android (Firebase Cloud Messaging HTTP v1): a service-account JSON key of your Firebase project
# with the "Firebase Cloud Messaging API Admin" role. Inline JSON or a file path.
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm.json
# FCM_SERVICE_ACCOUNT_JSON=
# iOS (APNs token auth): an APNs key (.p8) from developer.apple.com → Keys.
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_PRIVATE_KEY_FILE=/run/secrets/apns.p8
# APNS_BUNDLE_ID=ai.dhanz.dhanzAi
# APNS_USE_SANDBOX=false          # true for builds run from Xcode (development push environment)
# In-app update check: path to the latest.json published with each GitHub release.
# UPDATE_MANIFEST_FILE=/srv/data/latest.json

# ---- Assistant tools -------------------------------------------------------------
# Calculator, unit conversion, time/date maths, reminders, email drafts (for models with function calling).
ASSISTANT_TOOLS_ENABLED=true
# How often due reminders are checked and announced by push notification (seconds).
REMINDER_CHECK_SECONDS=30

# ---- Production readiness (Phase 5) -----------------------------------------
# For a server on the internet use deploy/docker-compose.prod.yml (HTTPS via Caddy); see docs/DEPLOY.md.
# DHANZ_DOMAIN=dhanz.example.com
# ACME_EMAIL=you@example.com
# false = private server: only the first account (the administrator) can register.
ALLOW_REGISTRATION=true
# Shared rate limits and login lockout across API workers/containers (docker compose sets it).
# REDIS_URL=redis://redis:6379/0
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Email: "Forgot password" codes and email verification codes. Leave SMTP_HOST empty to disable both.
SMTP_HOST=
SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=DHANZ AI <no-reply@example.com>
# starttls | ssl | none
SMTP_SECURITY=starttls
# New accounts confirm their email with a 6-digit code (needs SMTP). true = chats stay locked until then.
REQUIRE_EMAIL_VERIFICATION=false
# Encrypts two-step verification secrets. Set a random value (like JWT_SECRET) and keep it: changing
# it turns off two-step verification for everyone. Falls back to JWT_SECRET when empty.
# DATA_ENCRYPTION_KEY=
# Sign in with Google / Apple (see docs/INSTALL.md). Comma-separated OAuth client IDs whose tokens
# are accepted; the first Google ID must be the "Web application" client.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# Logs: text (development) or json (log collectors). Metrics at /metrics need this bearer token.
LOG_FORMAT=text
# METRICS_TOKEN=
# Clean-up job: user retention choices, temporary chats (hours), audit log (days). 0 minutes = off.
MAINTENANCE_INTERVAL_MINUTES=60
TEMPORARY_CHAT_HOURS=24
AUDIT_LOG_RETENTION_DAYS=365
# JSON request bodies above this are refused (uploads use MAX_UPLOAD_MB).
MAX_REQUEST_KB=512
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# balanced | cheapest | best | local_first
DEFAULT_ROUTING_POLICY=balanced
DEFAULT_MAX_TOKENS=2048

# ---- Limits ----------------------------------------------------------------
MAX_MESSAGE_CHARS=32000
HISTORY_MAX_MESSAGES=40
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=30

# Optional local OCR for scanned PDF pages (Docker includes English).
OCR_ENABLED=false
OCR_LANGUAGE=eng
OCR_MAX_PAGES=20
OCR_TIMEOUT_SECONDS=90

# ---- DHANZ Creative Studio (see docs/CREATIVE_STUDIO.md) ----------------------
CREATIVE_ENABLED=false
CREATIVE_WORKER_ENABLED=true
# Image/moderation keys fall back to OPENAI_API_KEY. Never expose these in the app.
CREATIVE_IMAGE_API_KEY=
CREATIVE_MODERATION_API_KEY=
CREATIVE_IMAGE_BASE_URL=https://api.openai.com/v1
CREATIVE_IMAGE_MODEL=gpt-image-2.5-sunburst
CREATIVE_IMAGE_EDITS=true
CREATIVE_IMAGE_TRANSPARENCY=true
RUNWAY_API_KEY=
# local for development; s3 is required for production Creative Studio.
CREATIVE_STORAGE=local
CREATIVE_STORAGE_DIR=./data/creations
CREATIVE_S3_BUCKET=
CREATIVE_S3_REGION=us-east-1
CREATIVE_S3_ENDPOINT=
# S3 uses IAM roles or standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY credentials.
CREATIVE_MEDIA_DAYS=30
CREATIVE_MAX_MEDIA_MB=100
CREATIVE_MAX_ACTIVE_JOBS=3
# Initial defaults; administrators can then change the policy in the studio.
CREATIVE_IMAGE_COST=5
CREATIVE_VIDEO_COST_PER_SECOND=10
CREATIVE_MONTHLY_ALLOWANCE=100
